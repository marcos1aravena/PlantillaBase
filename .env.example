POSTGRES_DB=base_app
POSTGRES_USER=base_user
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://base_user:change-this-database-password@localhost:5432/base_app?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=300
COOKIE_SECURE=false
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_LOCALE=es
SEED_SUPERADMIN_NAME=Superadministrador
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change-this-initial-password
